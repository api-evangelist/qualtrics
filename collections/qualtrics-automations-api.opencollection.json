{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qualtrics automations API",
    "version": "0.2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-TOKEN",
      "value": "{{X-API-TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "automations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Automations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{apiRegion}.qualtrics.com/API/{apiVersion}/automations",
            "params": [
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "The starting offset for the returned records. The default offset is 0.\n"
              }
            ]
          },
          "docs": "Get all automations' directory information."
        }
      ]
    }
  ],
  "bundled": true
}