          "item": [
            {
              "name": "files",
              "item": [
                {
                  "name": "Get Automation's Files",
                  "id": "f071eb60-72a7-4484-b47d-29498a4a0bf8",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/automations/:automationId/files?tag=<string>",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "automations",
                        ":automationId",
                        "files"
                      ],
                      "query": [
                        {
                          "description": "* If not provided, the files that have not yet been processed by the automation will be returned.\n* If equal to `processing`, the files that are currently being processed by the automation will be returned.\n* If equal to `archived`, the files that have been processed and archived by the automation will be returned.\n",
                          "key": "tag",
                          "value": "<string>"
                        }
                      ],
                      "variable": [
                        {
                          "id": "511e2fee-22e8-40bd-b999-e8efde6d8daa",
                          "key": "automationId",
                          "value": "<string>",
                          "description": "(Required) Id of the associated automation.\n\n**Example**: `AU_123456789012345`\n"
                        }
                      ]
                    },
                    "description": "Get all the files for Automation which are neither archived or currently being processed."
                  },
                  "response": [
                    {
                      "id": "86feeaea-638d-4a8d-bae0-2676d1a65d41",
                      "name": "Files List",
